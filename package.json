{
  "name": "movie-platform-api",
  "version": "1.0.0",
  "description": "A RESTful and GraphQL API for managing a movie catalog, built with Node.js, TypeScript, and Express. Integrates with the [TMDB (The Movie Database)](https://www.themoviedb.org/) API to enrich movie data, with PostgreSQL for persistence and in-memory caching for performance.",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.js --runInBand",
    "kiota": "kiota generate -l typescript -d openapi.yaml -c MovieClient -o ./client",
    "seed:admin": "tsx src/scripts/seedAdmin.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tieson18/movie-platform-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Tieson18/movie-platform-api/issues"
  },
  "homepage": "https://github.com/Tieson18/movie-platform-api#readme",
  "dependencies": {
    "@microsoft/kiota-bundle": "^1.0.0-preview.100",
    "apollo-server-express": "^3.13.0",
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "graphql": "^16.13.2",
    "jsonwebtoken": "^9.0.3",
    "node-cache": "^5.1.2",
    "pg": "^8.20.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
