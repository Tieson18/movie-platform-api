  },
  "homepage": "https://github.com/Tieson18/movie-platform-api#readme",
  "dependencies": {
    "apollo-server-express": "^3.13.0",
    "axios": "^1.15.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "graphql": "^16.13.2",
    "node-cache": "^5.1.2",
    "pg": "^8.20.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
